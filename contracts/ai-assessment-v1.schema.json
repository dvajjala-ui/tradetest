{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dvajjala-ui/tradetest/blob/main/contracts/ai-assessment-v1.schema.json",
  "title": "TradeTest dated assessment v1",
  "description": "An offline research assessment. Continue permits further deterministic review and grants no order authority. The .NET gate additionally binds identities, citations and expiry to the request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "modelId", "promptVersion", "contextHash", "decision", "reasonCodes", "supportingFactIds", "contradictingFactIds", "missingEvidence", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": "tradetest-ai-assessment-v1" },
    "caseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "promptVersion": { "const": "dated-candidate-review-v1" },
    "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "enum": ["Continue", "Reject", "Wait", "Escalate"] },
    "reasonCodes": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["SupportsBaseline", "ContradictoryEvidence", "InsufficientEvidence", "StaleEvidence", "UntrustedInstructions", "OtherRisk"] }
    },
    "supportingFactIds": { "$ref": "#/$defs/factIds" },
    "contradictingFactIds": { "$ref": "#/$defs/factIds" },
    "missingEvidence": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "factIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [{
    "if": { "properties": { "decision": { "const": "Continue" } } },
    "then": { "properties": {
      "supportingFactIds": { "minItems": 1 },
      "reasonCodes": { "contains": { "const": "SupportsBaseline" } },
      "missingEvidence": { "maxItems": 0 }
    } }
  }]
}
